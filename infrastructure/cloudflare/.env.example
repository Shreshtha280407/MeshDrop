# Copy separately to preview/.env and production/.env, or use deploy:cloud init.
# Keep real values only in .env files (0600); never in chat or GitHub source.
CLOUDFLARE_ACCOUNT_ID=
# Optional with an existing local wrangler login. Required for unattended CI.
CLOUDFLARE_API_TOKEN=
PAGES_PROJECT=meshdrop-yourname-preview
# Leave empty to use https://PAGES_PROJECT.pages.dev.
PUBLIC_ORIGIN=
# deploy:cloud init generates this independently for each environment.
OPS_REVOKE_SECRET=
ADMISSION_PAUSED=false
# direct | coturn | cloudflare. Direct-only networks can fail behind restrictive NATs.
TURN_PROVIDER=direct
# coturn only: set both fields, leave Cloudflare credentials empty.
TURN_URLS=
TURN_SHARED_SECRET=
# cloudflare only: create a dedicated TURN key per environment in Realtime → TURN.
# These are TURN key credentials, not the deployment API token.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

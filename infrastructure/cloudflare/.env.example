# Copy separately to preview/.env and production/.env, or use deploy:cloud init.
# Keep real values only in .env files (0600); never in chat or GitHub source.
CLOUDFLARE_ACCOUNT_ID=
# Optional with an existing local wrangler login. Required for unattended CI.
CLOUDFLARE_API_TOKEN=
PAGES_PROJECT=meshdrop-yourname-preview
# Leave empty to use https://PAGES_PROJECT.pages.dev.
PUBLIC_ORIGIN=
# deploy:cloud init generates this independently for each environment.
OPS_REVOKE_SECRET=
# Explicit desired state. It is checked against live state before any future publish.
ADMISSION_PAUSED=true
ADMISSION_ACTION=preserve
# Only for a reviewed reopening: REOPEN:environment:current-worker-version:manifest-id
ADMISSION_REOPEN_CONFIRMATION=
# direct | coturn | cloudflare | metered. Direct-only networks can fail behind restrictive NATs.
TURN_PROVIDER=direct
# coturn only: set both fields, leave Cloudflare credentials empty.
TURN_URLS=
TURN_SHARED_SECRET=
# cloudflare only: create a dedicated TURN key per environment in Realtime → TURN.
# These are TURN key credentials, not the deployment API token.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# metered only: the verified $0 500 MB hard-stop plan; no overages or payments.
# The master key stays server-side. The pool warms expiring credentials ahead of use.
METERED_DOMAIN=
METERED_SECRET_KEY=
METERED_FREE_ONLY=
# Local operations only. Account -> Notifications -> Edit for this account.
# This token is not uploaded as an application Worker secret.
CLOUDFLARE_NOTIFICATIONS_API_TOKEN=

# Optional account-scoped Analytics Read token for free account request monitoring.
CLOUDFLARE_ANALYTICS_API_TOKEN=

{
  "name": "meshdrop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @meshdrop/web dev",
    "dev:signaling": "pnpm --filter @meshdrop/signaling dev",
    "bench:p3": "tsx scripts/local-dev/verify-streaming.mjs",
    "demo:p0": "tsx scripts/local-dev/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --reporter verbose",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project chromium",
    "test:faults": "vitest run --project faults",
    "test:load": "node scripts/benchmarks/load.mjs matrix",
    "test:load:browser": "node scripts/benchmarks/load.mjs browser",
    "test:transfer-reliability": "vitest run --project unit tests/unit/transfer-stop.spec.ts tests/unit/transfer-lifecycle.spec.ts && vitest run --project security tests/security/transfer-control-abort.spec.ts packages/recovery/tests/property/transfer-reliability.spec.ts && vitest run --project faults tests/faults/transfer-reliability.spec.ts",
    "test:storage-lifecycle": "vitest run --project unit tests/unit/storage-lifecycle.spec.ts tests/unit/storage-client-lifecycle.spec.ts && playwright test tests/storage/lifecycle- --retries 0",
    "test:release-store": "vitest run --config vitest.release-trust.config.ts",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck && pnpm typecheck && pnpm lint && pnpm check:secrets && pnpm test:unit && pnpm test:security && pnpm test:integration && pnpm test:faults && pnpm test:release-store && pnpm build && pnpm test:e2e && pnpm test:pwa",
    "check:secrets": "node scripts/check-secrets.mjs",
    "bench:p4": "tsx scripts/local-dev/verify-storage.mjs",
    "bench:p5": "bash scripts/local-dev/run-resume-network.sh",
    "bench:p6": "playwright test tests/e2e/network-intelligence.spec.ts --project chromium --workers 1 --retries 0",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "bench:p7": "playwright test tests/e2e/mobile-hardening.spec.ts --project chromium --workers 1 --retries 0 && pnpm test:pwa",
    "test:security": "vitest run --project security --reporter default --reporter json --outputFile .meshdrop-artifacts/phase-8/security.json",
    "test:security-redteam": "vitest run --project unit tests/unit/privacy-boundaries.spec.ts tests/unit/secret-policy.spec.ts && vitest run --project security tests/security/adversarial-protocol.spec.ts tests/security/diagnostics-privacy.spec.ts && vitest run --project integration tests/integration/adversarial-auth.spec.ts && vitest run --project faults tests/faults/adversarial-transfer.spec.ts",
    "bench:p8": "pnpm test:security && pnpm test:integration && playwright test tests/e2e/security-abuse.spec.ts --project chromium --workers 1 --retries 0 && pnpm test:pwa",
    "audit:release": "pnpm audit --audit-level low",
    "deploy:cloud": "tsx scripts/deploy/cloudflare.ts",
    "bench:p9": "node scripts/benchmarks/release.mjs",
    "verify:rollback": "tsx scripts/deploy/verify-rollback.ts",
    "verify:rollback-target": "tsx scripts/deploy/verify-rollback-target.ts",
    "inspect:release-record": "tsx scripts/deploy/inspect-release-record.ts",
    "inspect:release-trust": "tsx scripts/deploy/inspect-release-trust.ts",
    "preflight:cloud": "tsx scripts/deploy/preflight-cloudflare.ts",
    "verify:public": "tsx scripts/deploy/public-smoke.ts",
    "verify:phone": "node --import tsx scripts/deploy/verify-phone.mjs",
    "verify:public-rollback": "tsx scripts/deploy/verify-public-rollback.ts",
    "verify:pages-rollback": "tsx scripts/deploy/verify-pages-rollback.ts",
    "verify:product-rollback": "tsx scripts/deploy/verify-product-rollback.ts",
    "ops:status": "tsx scripts/deploy/operations.ts status",
    "ops:warm-relay": "tsx scripts/deploy/operations.ts warm",
    "ops:evaluate": "tsx scripts/deploy/operations.ts evaluate",
    "ops:test-alert": "tsx scripts/deploy/operations.ts test-alert",
    "verify:operations": "tsx scripts/deploy/operations.ts verify",
    "verify:free-relay": "tsx scripts/local-dev/verify-free-relay.ts",
    "verify:ios": "node scripts/local-dev/verify-ios.mjs",
    "verify:device-cloud": "node scripts/local-dev/verify-ios.mjs",
    "verify:platform-cloud": "node scripts/local-dev/verify-platforms.mjs",
    "rehearsal:check-config": "tsx scripts/rehearsal/cli.ts check-config",
    "preview:canary": "tsx scripts/preview/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@meshdrop/protocol": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "eslint": "10.12.0",
    "miniflare": "5.20261012.0-beta",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "ws": "8.21.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": "0.28.1",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1"
    }
  }
}

{
  "name": "meshdrop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @meshdrop/web dev",
    "dev:signaling": "pnpm --filter @meshdrop/signaling dev",
    "bench:p3": "tsx scripts/local-dev/verify-streaming.mjs",
    "demo:p0": "tsx scripts/local-dev/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --reporter verbose",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project chromium",
    "test:faults": "vitest run --project faults",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck && pnpm typecheck && pnpm lint && pnpm check:secrets && pnpm test:unit && pnpm test:integration && pnpm test:faults && pnpm build && pnpm test:e2e",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@meshdrop/protocol": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.3",
    "eslint": "10.12.0",
    "miniflare": "5.20261012.0-beta",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.0.18",
    "ws": "8.21.0"
  }
}

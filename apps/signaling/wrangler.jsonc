{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshdrop-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "development",
    "AUDIT_LOGS": "false",
    "STUN_URLS": "stun:stun.cloudflare.com:3478",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
    "ROOM_TTL_SECONDS": "900",
    "INVITE_TTL_SECONDS": "300",
    "WS_TICKET_TTL_SECONDS": "30",
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "RELAY_POOLS", "class_name": "RelayPool" },
      { "name": "OPERATIONS_MONITOR", "class_name": "OperationsMonitor" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RelayPool", "OperationsMonitor"] },
  ],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "REQUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
  ],
}

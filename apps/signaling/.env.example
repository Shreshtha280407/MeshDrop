# Public local configuration only. Never put real credentials in this template.
# Copy to .env beside wrangler.jsonc. .env is ignored by Git.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ROOM_TTL_SECONDS=900
INVITE_TTL_SECONDS=300
WS_TICKET_TTL_SECONDS=30
CLOSED_TOMBSTONE_SECONDS=60
# Public STUN endpoint. Leave empty for an offline LAN-only development session.
STUN_URLS=stun:stun.cloudflare.com:3478
# Optional coturn TURN REST configuration. Leave BOTH empty to disable relay.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=300
# Real shared secrets belong only in ignored .env, never in VITE_* variables.

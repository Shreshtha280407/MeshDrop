# Public local configuration only. Never put real credentials in this template.
# Copy to .env beside wrangler.jsonc. .env is ignored by Git.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ROOM_TTL_SECONDS=900
INVITE_TTL_SECONDS=300
WS_TICKET_TTL_SECONDS=30
CLOSED_TOMBSTONE_SECONDS=60
# P1 uses random opaque credentials, so no shared signing secret is required.
# Future provider secrets belong only in this ignored .env, never VITE_* variables.
